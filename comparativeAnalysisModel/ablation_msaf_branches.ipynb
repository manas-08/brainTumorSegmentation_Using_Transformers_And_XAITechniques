   "source": [
    "def fmt_table(df):\n",
    "    cols = [\"Configuration\", \"FLAIR DSC\", \"T1CE DSC\", \"T1 DSC\", \"Mean DSC\", \"Mean HD95\", \"Params\"]\n",
    "    md = \"| \" + \" | \".join(cols) + \" |\\n\"\n",
    "    md += \"|\" + \"|\".join([\"---\"] * len(cols)) + \"|\\n\"\n",
    "    for _, r in df.iterrows():\n",
    "        md += \"| \" + \" | \".join(str(r[c]) for c in cols) + \" |\\n\"\n",
    "    return md\n",
    "\n",
    "print(fmt_table(df))\n",
    "\n",
    "print(\"\\n--- DSC/IoU identity check (must match to 4 decimals) ---\")\n",
    "for _, r in df.iterrows():\n",
    "    print(f\"{r['Configuration']:<40s}  IoU(computed)={r['_IoU_check']}  \"\n",
    "          f\"IoU(identity)={r['_IoU_identity']}\")\n",
    "\n",
    "print(\"\\n--- Mean-DSC arithmetic check ---\")\n",
    "for _, r in df.iterrows():\n",
    "    mu = round((r[\"FLAIR DSC\"] + r[\"T1CE DSC\"] + r[\"T1 DSC\"]) / 3, 4)\n",
    "    ok = abs(mu - r[\"Mean DSC\"]) < 5e-4\n",
    "    print(f\"{r['Configuration']:<40s}  mean_direct={mu}  mean_reported={r['Mean DSC']}  OK={ok}\")"
   ]
  }

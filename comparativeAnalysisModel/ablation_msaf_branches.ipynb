    "# Evaluation loop\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate(model, loader):\n",
    "    model.eval()\n",
    "    tp = np.zeros(NUM_CLASSES, np.int64)\n",
    "    fp = np.zeros(NUM_CLASSES, np.int64)\n",
    "    fn = np.zeros(NUM_CLASSES, np.int64)\n",
    "    tn = np.zeros(NUM_CLASSES, np.int64)\n",
    "    hd_list = [[] for _ in range(NUM_CLASSES)]\n",
    "\n",
    "    for img, sal, _pid in loader:\n",
    "        img = img.to(DEVICE, non_blocking=True)          # (1,3,D,224,224)\n",
    "        B, C, D, H, W = img.shape\n",
    "        vol = img.permute(0, 2, 1, 3, 4).reshape(B * D, C, H, W)   # fold depth into batch\n",
    "        logits, _ = model(vol)\n",
    "        pred = logits.argmax(1).cpu().numpy().reshape(B, D, H, W)\n",
    "        gt   = sal.numpy()\n",
    "\n",
    "        for b in range(B):\n",
    "            for d in range(D):\n",
    "                p, g = pred[b, d], gt[b, d]\n",
    "                t, f, n, tnn = per_class_confusion(p, g)\n",
    "                tp += t; fp += f; fn += n; tn += tnn\n",
    "                for c in range(NUM_CLASSES):\n",
    "                    v = hd95(p == c, g == c)\n",
    "                    if not math.isnan(v):\n",
    "                        hd_list[c].append(v)\n",
    "\n",
    "    dsc, iou, sens, spec = dsc_iousens_spec(tp, fp, fn, tn)\n",
    "    hd = [np.mean(v) if v else float(\"nan\") for v in hd_list]\n",
    "    return {\"dsc\": dsc, \"iou\": iou, \"sens\": sens, \"spec\": spec, \"hd95\": hd,\n",
    "            \"counts\": {\"tp\": tp.tolist(), \"fp\": fp.tolist(), \"fn\": fn.tolist(), \"tn\": tn.tolist()}}"
   ]
  },

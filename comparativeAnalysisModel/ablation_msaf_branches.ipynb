    "#SwinUNet wrapper with MSAF insertion\n",
    "\n",
    "class SwinUNetWithMSAF(nn.Module):\n",
    "    \"\"\"\n",
    "    Shared SwinUNet encoder-decoder with MSAF applied to every skip connection.\n",
    "    The `mode` argument is forwarded to every MSAF so the entire network switches\n",
    "    between full / channel-only / spatial-only in one place.\n",
    "    \"\"\"\n",
    "    def __init__(self, swin_backbone, decoder, msaf_channels, msaf_mode=\"both\",\n",
    "                 num_classes=3, deep_supervision=False):\n",
    "        super().__init__()\n",
    "        self.encoder = swin_backbone\n",
    "        self.decoder = decoder\n",
    "        self.msaf = nn.ModuleList(\n",
    "            [MSAF(c, mode=msaf_mode) for c in msaf_channels]\n",
    "        )\n",
    "        self.head = nn.Conv2d(decoder.out_channels, num_classes, kernel_size=1)\n",
    "        self.deep_supervision = deep_supervision\n",
    "        if deep_supervision:\n",
    "            self.aux_heads = nn.ModuleList(\n",
    "                [nn.Conv2d(decoder.out_channels // (2 ** k), num_classes, 1)\n",
    "                 for k in (0, 1)]\n",
    "            )\n",
    "\n",
    "    def forward(self, x):\n",
    "        skips = self.encoder(x)                                  # list of feature maps\n",
    "        refined = [m(s) for m, s in zip(self.msaf, skips)]       # MSAF on each skip\n",
    "        dec_out, aux_outs = self.decoder(refined, return_aux=self.deep_supervision)\n",
    "        logits = self.head(dec_out)\n",
    "        if self.deep_supervision:\n",
    "            aux_logits = [h(a) for h, a in zip(self.aux_heads, aux_outs)]\n",
    "            return logits, aux_logits\n",
    "        return logits, None\n",
    "\n",
    "\n",
    "def build_model(msaf_mode=\"both\", deep_supervision=False):\n",
    "    \"\"\"\n",
    "    Instantiate the network exactly as the training notebooks do, but with the\n",
    "    MSAF branch mode chosen at construction time. Imported modules are pulled\n",
    "    from the repository so no architectural drift is introduced.\n",
    "    \"\"\"\n",
    "    sys.path.insert(0, str(REPO_ROOT))\n",
    "    from models.swin_unet import SwinEncoder, UNetDecoder       # adjust if names differ\n",
    "    enc = SwinEncoder(img_size=224, in_chans=3, embed_dim=96, depths=[2,2,6,2],\n",
    "                      num_heads=[3,6,12,24], window_size=7)\n",
    "    dec = UNetDecoder(in_channels=768, out_channels=96)\n",
    "    model = SwinUNetWithMSAF(\n",
    "        swin_backbone=enc, decoder=dec,\n",
    "        msaf_channels=[96, 192, 384, 768],\n",
    "        msaf_mode=msaf_mode, num_classes=NUM_CLASSES,\n",
    "        deep_supervision=deep_supervision,\n",
    "    )\n",
    "    return model.to(DEVICE)\n",
    "\n",
    "\n",
    "def count_params(m):\n",
    "    return sum(p.numel() for p in m.parameters() if p.requires_grad)"
   ]
  },

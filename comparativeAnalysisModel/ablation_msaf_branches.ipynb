    "# Optional fine-tuning for the two new branches\n",
    "\n",
    "def build_base_for_loading(msaf_mode, ds):\n",
    "    \"\"\"Baseline variants have no MSAF modules at all; build the plain SwinUNet.\"\"\"\n",
    "    if msaf_mode is None:\n",
    "        sys.path.insert(0, str(REPO_ROOT))\n",
    "        from models.swin_unet import SwinUNet\n",
    "        m = SwinUNet(img_size=224, in_chans=3, num_classes=NUM_CLASSES).to(DEVICE)\n",
    "        return m\n",
    "    return build_model(msaf_mode=msaf_mode, deep_supervision=ds)\n",
    "\n",
    "\n",
    "def load_ckpt(model, path):\n",
    "    sd = torch.load(path, map_location=DEVICE)\n",
    "    sd = sd.get(\"model\", sd.get(\"state_dict\", sd))\n",
    "    missing, unexpected = model.load_state_dict(sd, strict=False)\n",
    "    print(f\"  loaded {path.name}: missing={len(missing)} unexpected={len(unexpected)}\")\n",
    "    return model\n",
    "\n",
    "\n",
    "def finetune_from_msaf(target_mode, train_loader, epochs=FINETUNE_EPOCHS, lr=FINETUNE_LR):\n",
    "    \"\"\"\n",
    "    Initialise the branch-isolated model from the trained full-MSAF checkpoint,\n",
    "    freezing everything except the target branch's parameters and the head.\n",
    "    This keeps the comparison honest (same optimisation schedule, same data)\n",
    "    while actually removing the non-target branch from the forward pass.\n",
    "    \"\"\"\n",
    "    model = build_model(msaf_mode=target_mode, deep_supervision=False)\n",
    "    src = CKPT_DIR / \"msaf_no_ds.pth\"\n",
    "    assert src.exists(), f\"Need {src} to initialise {target_mode} variant\"\n",
    "    load_ckpt(model, src)\n",
    "\n",
    "    # Freeze everything except the active branch and the segmentation head\n",
    "    for name, p in model.named_parameters():\n",
    "        p.requires_grad = False\n",
    "    for name, p in model.named_parameters():\n",
    "        if (target_mode == \"channel\" and \".ca.\" in name) \\\n",
    "        or (target_mode == \"spatial\" and \".sa.\" in name) \\\n",
    "        or name.startswith(\"head.\") \\\n",
    "        or name in (\"alpha\", \"beta\"):\n",
    "            p.requires_grad = True\n",
    "\n",
    "    params = [p for p in model.parameters() if p.requires_grad]\n",
    "    opt = torch.optim.AdamW(params, lr=lr, weight_decay=1e-4)\n",
    "    crit = nn.CrossEntropyLoss(ignore_index=IGNORE_INDEX)\n",
    "\n",
    "    model.train()\n",
    "    for ep in range(epochs):\n",
    "        running = 0.0\n",
    "        for img, sal, _ in train_loader:\n",
    "            img = img.to(DEVICE); sal = sal.to(DEVICE)\n",
    "            B, C, D, H, W = img.shape\n",
    "            x = img.permute(0, 2, 1, 3, 4).reshape(B * D, C, H, W)\n",
    "            y = sal.reshape(B * D, H, W)\n",
    "            logits, _ = model(x)\n",
    "            loss = crit(logits, y)\n",
    "            opt.zero_grad(); loss.backward(); opt.step()\n",
    "            running += loss.item()\n",
    "        print(f\"  [{target_mode}] epoch {ep+1}/{epochs}  loss={running/len(train_loader):.4f}\")\n",
    "\n",
    "    ckpt = OUT_DIR / f\"msaf_{target_mode}_no_ds.pth\"\n",
    "    torch.save({\"model\": model.state_dict()}, ckpt)\n",
    "    print(f\"  saved {ckpt}\")\n",
    "    return ckpt"
   ]
  },

    "#Run all configurations\n",
    "val_ds = BraTS2020Val(DATA_ROOT)\n",
    "val_loader = make_loader(val_ds, batch_size=1)\n",
    "print(f\"Validation patients: {len(val_ds)}\")\n",
    "\n",
    "# Optional fine-tune for the two new branches \n",
    "train_ds = BraTS2020Val(DATA_ROOT, resample=224)   \n",
    "train_loader = DataLoader(train_ds, batch_size=1, shuffle=True, num_workers=2)\n",
    "\n",
    "if FINETUNE_FROM_MSAF:\n",
    "    for mode in (\"channel\", \"spatial\"):\n",
    "        out_ckpt = OUT_DIR / f\"msaf_{mode}_no_ds.pth\"\n",
    "        if not out_ckpt.exists():\n",
    "            finetune_from_msaf(mode, train_loader)\n",
    "        CONFIGS[f\"+MSAF-{'C' if mode=='channel' else 'S'} \"\n",
    "                f\"({'channel' if mode=='channel' else 'spatial'} only, no DS)\"][\"ckpt\"] = out_ckpt.name\n",
    "\n",
    "rows = []\n",
    "for name, cfg in CONFIGS.items():\n",
    "    print(f\"\\n>>> {name}\")\n",
    "    if cfg[\"msaf_mode\"] is None:\n",
    "        model = build_base_for_loading(None, cfg[\"ds\"])\n",
    "    else:\n",
    "        model = build_model(msaf_mode=cfg[\"msaf_mode\"], deep_supervision=cfg[\"ds\"])\n",
    "\n",
    "    ckpt_path = CKPT_DIR / cfg[\"ckpt\"] if cfg[\"ckpt\"] else OUT_DIR / f\"msaf_{cfg['msaf_mode']}_no_ds.pth\"\n",
    "    if ckpt_path.exists():\n",
    "        model = load_ckpt(model, ckpt_path)\n",
    "    else:\n",
    "        print(f\"  WARNING: checkpoint {ckpt_path} not found; skipping.\")\n",
    "        continue\n",
    "\n",
    "    n_params = count_params(model)\n",
    "    res = evaluate(model, val_loader)\n",
    "    row = {\n",
    "        \"Configuration\": name,\n",
    "        \"FLAIR DSC\": round(float(res[\"dsc\"][0]), 4),\n",
    "        \"T1CE DSC\":  round(float(res[\"dsc\"][1]), 4),\n",
    "        \"T1 DSC\":    round(float(res[\"dsc\"][2]), 4),\n",
    "        \"Mean DSC\":  round(float(np.mean(res[\"dsc\"])), 4),\n",
    "        \"Mean HD95\": round(float(np.nanmean(res[\"hd95\"])), 4),\n",
    "        \"Params\":    int(n_params),\n",
    "        # Sanity cross-check columns\n",
    "        \"_IoU_check\": [round(float(v), 4) for v in res[\"iou\"]],\n",
    "        \"_IoU_identity\": [round(float(d / (2 - d)), 4) if d < 2 else None for d in res[\"dsc\"]],\n",
    "    }\n",
    "    rows.append(row)\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "df = pd.DataFrame(rows)\n",
    "df.to_csv(OUT_DIR / \"ablation_results.csv\", index=False)\n",
    "print(\"\\nSaved:\", OUT_DIR / \"ablation_results.csv\")"
   ]

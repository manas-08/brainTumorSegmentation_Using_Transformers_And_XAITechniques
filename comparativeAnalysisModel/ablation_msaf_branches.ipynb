    "#BraTS 2020 validation dataset\n",
    "\n",
    "class BraTS2020Val(Dataset):\n",
    "    \"\"\"\n",
    "    Loads BraTS 2020 volumes and produces (3,224,224) slices with\n",
    "    modality-salience labels derived from the subregion annotation:\n",
    "        ED  -> class 0 (FLAIR)\n",
    "        ET  -> class 1 (T1CE)\n",
    "        NCR -> class 2 (T1)\n",
    "    Background voxels get IGNORE_INDEX and are excluded from the loss / metrics.\n",
    "    \"\"\"\n",
    "    MODALITIES = (\"t1\", \"t1ce\", \"flair\")\n",
    "\n",
    "    def __init__(self, root: Path, resample=224):\n",
    "        self.root = Path(root); self.resample = resample\n",
    "        self.patients = sorted([p for p in self.root.iterdir() if p.is_dir()])\n",
    "        assert len(self.patients) > 0, f\"No patients found under {self.root}\"\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.patients)\n",
    "\n",
    "    def _load(self, patient):\n",
    "        import nibabel as nib\n",
    "        vols = []\n",
    "        for m in self.MODALITIES:\n",
    "            path = next(patient.glob(f\"*_{m}.nii*\"))\n",
    "            vol = nib.load(str(path)).get_fdata().astype(np.float32)\n",
    "            # z-score using nonzero voxels only\n",
    "            nz = vol[vol > 0]\n",
    "            vol = (vol - nz.mean()) / (nz.std() + 1e-8)\n",
    "            vols.append(vol)\n",
    "        seg = nib.load(str(next(patient.glob(\"*_seg.nii*\")))).get_fdata().astype(np.uint8)\n",
    "        # BraTS label convention: 1=NCR, 2=ED, 4=ET\n",
    "        salience = np.full(seg.shape, IGNORE_INDEX, dtype=np.uint8)\n",
    "        salience[seg == 2] = 0            # ED  -> FLAIR\n",
    "        salience[seg == 4] = 1            # ET  -> T1CE\n",
    "        salience[seg == 1] = 2            # NCR -> T1\n",
    "        return np.stack(vols, axis=0), salience   # (3,D,H,W), (D,H,W)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        patient = self.patients[idx]\n",
    "        img, sal = self._load(patient)\n",
    "        img = torch.from_numpy(img)                      # (3,D,H,W)\n",
    "        sal = torch.from_numpy(sal).long()               # (D,H,W)\n",
    "        img = F.interpolate(img.permute(1, 0, 2, 3),      # (D,3,H,W)\n",
    "                            size=(self.resample, self.resample),\n",
    "                            mode=\"bilinear\", align_corners=False)\n",
    "        img = img.permute(1, 0, 2, 3).contiguous()       # (3,D,224,224)\n",
    "        sal = F.interpolate(sal[None, None].float(),       # (1,1,D,H,W)\n",
    "                            size=(sal.shape[0], self.resample, self.resample),\n",
    "                            mode=\"nearest\")[:, 0].long()   # (D,224,224)\n",
    "        return img, sal, str(patient.name)\n",
    "\n",
    "\n",
    "def make_loader(ds, batch_size=1):\n",
    "    return DataLoader(ds, batch_size=batch_size, shuffle=False, num_workers=2, pin_memory=True)"
   ]

    "#MSAF module with explicit branch toggles\n",
    "\n",
    "class ChannelAttention(nn.Module):\n",
    "    def __init__(self, channels, reduction=16):\n",
    "        super().__init__()\n",
    "        self.gap = nn.AdaptiveAvgPool2d(1)\n",
    "        self.fc  = nn.Sequential(\n",
    "            nn.Linear(channels, channels // reduction, bias=False),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Linear(channels // reduction, channels, bias=False),\n",
    "        )\n",
    "        self.sigmoid = nn.Sigmoid()\n",
    "\n",
    "    def forward(self, x):\n",
    "        b, c, _, _ = x.size()\n",
    "        y = self.gap(x).view(b, c)\n",
    "        y = self.sigmoid(self.fc(y)).view(b, c, 1, 1)\n",
    "        return x * y\n",
    "\n",
    "\n",
    "class SpatialAttention(nn.Module):\n",
    "    def __init__(self, kernel_size=7):\n",
    "        super().__init__()\n",
    "        self.conv = nn.Conv2d(2, 1, kernel_size, padding=kernel_size // 2, bias=False)\n",
    "        self.sigmoid = nn.Sigmoid()\n",
    "\n",
    "    def forward(self, x):\n",
    "        avg_out = torch.mean(x, dim=1, keepdim=True)\n",
    "        max_out, _ = torch.max(x, dim=1, keepdim=True)\n",
    "        attn = self.sigmoid(self.conv(torch.cat([avg_out, max_out], dim=1)))\n",
    "        return x * attn\n",
    "\n",
    "\n",
    "class MSAF(nn.Module):\n",
    "    \"\"\"\n",
    "    Multi-Scale Attention Fusion module.\n",
    "\n",
    "    Branch activation is controlled by two flags so that the exact same class\n",
    "    can instantiate the full module and each branch-isolated variant:\n",
    "\n",
    "        mode='both'   -> channel + spatial (full MSAF)\n",
    "        mode='channel'-> channel branch only (MSAF-C)\n",
    "        mode='spatial'-> spatial branch only (MSAF-S)\n",
    "    \"\"\"\n",
    "    def __init__(self, channels, mode=\"both\"):\n",
    "        super().__init__()\n",
    "        assert mode in {\"both\", \"channel\", \"spatial\"}, mode\n",
    "        self.mode = mode\n",
    "        self.use_channel = mode in {\"both\", \"channel\"}\n",
    "        self.use_spatial = mode in {\"both\", \"spatial\"}\n",
    "        if self.use_channel:\n",
    "            self.ca = ChannelAttention(channels)\n",
    "        if self.use_spatial:\n",
    "            self.sa = SpatialAttention()\n",
    "        # Learnable fusion weights (only created for the branches that are active)\n",
    "        self.alpha = nn.Parameter(torch.tensor(1.0)) if self.use_channel else None\n",
    "        self.beta  = nn.Parameter(torch.tensor(1.0)) if self.use_spatial else None\n",
    "\n",
    "    def forward(self, x):\n",
    "        out = x\n",
    "        if self.use_channel:\n",
    "            out = out + self.alpha * self.ca(x)\n",
    "        if self.use_spatial:\n",
    "            out = out + self.beta  * self.sa(x)\n",
    "        return out"
   ]

    "#Metrics (DSC, IoU, Sensitivity, Specificity, HD95)\n",
    "\n",
    "def per_class_confusion(pred, gt, num_classes=NUM_CLASSES, ignore=IGNORE_INDEX):\n",
    "    \"\"\"Returns TP, FP, FN per class over all pixels in one slice.\"\"\"\n",
    "    valid = gt != ignore\n",
    "    p, g = pred[valid], gt[valid]\n",
    "    tp = np.zeros(num_classes, dtype=np.int64)\n",
    "    fp = np.zeros(num_classes, dtype=np.int64)\n",
    "    fn = np.zeros(num_classes, dtype=np.int64)\n",
    "    tn = np.zeros(num_classes, dtype=np.int64)\n",
    "    for c in range(num_classes):\n",
    "        tp[c] = np.sum((p == c) & (g == c))\n",
    "        fp[c] = np.sum((p == c) & (g != c))\n",
    "        fn[c] = np.sum((p != c) & (g == c))\n",
    "        tn[c] = np.sum((p != c) & (g != c))\n",
    "    return tp, fp, fn, tn\n",
    "\n",
    "\n",
    "def dsc_iousens_spec(tp, fp, fn, tn):\n",
    "    eps = 1e-8\n",
    "    dsc  = 2 * tp / (2 * tp + fp + fn + eps)\n",
    "    iou  = dsc / (1 - dsc)\n",
    "    sens = tp / (tp + fn + eps)\n",
    "    spec = tn / (tn + fp + eps)\n",
    "    return dsc, iou, sens, spec\n",
    "\n",
    "\n",
    "def hd95(pred_mask, gt_mask, spacing=(1.0, 1.0)):\n",
    "    \"\"\"\n",
    "    95th-percentile symmetric Hausdorff distance between binary masks.\n",
    "    Returns distance in in-plane pixels on the resampled grid.\n",
    "    \"\"\"\n",
    "    if not pred_mask.any() and not gt_mask.any():\n",
    "        return 0.0\n",
    "    if not pred_mask.any() or not gt_mask.any():\n",
    "        return float(\"nan\")\n",
    "\n",
    "    def surface(m):\n",
    "        er = binary_erosion(m, structure=np.ones((3, 3), bool))\n",
    "        return m ^ er\n",
    "\n",
    "    ps, gs = surface(pred_mask), surface(gt_mask)\n",
    "    if not ps.any() or not gs.any():\n",
    "        return float(\"nan\")\n",
    "    dt_gt = distance_transform_edt(~gs, sampling=spacing)\n",
    "    dt_pd = distance_transform_edt(~ps, sampling=spacing)\n",
    "    d_pg = dt_gt[ps]; d_gp = dt_pd[gs]\n",
    "    return float(max(np.percentile(d_pg, 95), np.percentile(d_gp, 95)))"
   ]
  },

    "#Configuration registry\n",
    "\n",
    "CONFIGS = {\n",
    "    \"Baseline (no MSAF, no DS)\":      dict(msaf_mode=None,        ds=False, ckpt=\"baseline.pth\"),\n",
    "    \"+DS (no MSAF)\":                  dict(msaf_mode=None,        ds=True,  ckpt=\"baseline_ds.pth\"),\n",
    "    \"+MSAF-C (channel only, no DS)\":  dict(msaf_mode=\"channel\",   ds=False, ckpt=None),\n",
    "    \"+MSAF-S (spatial only, no DS)\":  dict(msaf_mode=\"spatial\",   ds=False, ckpt=None),\n",
    "    \"+MSAF (channel + spatial, no DS)\": dict(msaf_mode=\"both\",    ds=False, ckpt=\"msaf_no_ds.pth\"),\n",
    "    \"+MSAF + DS (Proposed)\":          dict(msaf_mode=\"both\",      ds=True,  ckpt=\"msaf_ds.pth\"),\n",
    "}\n",
    "\n",
    "FINETUNE_FROM_MSAF = True      \n",
    "FINETUNE_EPOCHS    = 5\n",
    "FINETUNE_LR        = 1e-4"
   ]
  },
  {
